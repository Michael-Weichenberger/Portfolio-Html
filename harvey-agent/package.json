{
  "name": "harvey-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Kasi: Website-Messung, Akquise-Pipeline, Kundenverwaltung (Dashboard), Rechnungen und Mahnwesen für MW IT-SERVICES.",
  "main": "harvey-worker.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "check": "node harvey-worker.js",
    "cf:dev": "npx wrangler dev --config cloudflare/wrangler.toml",
    "cf:deploy": "npx wrangler deploy --config cloudflare/wrangler.toml",
    "dash:dev": "npx wrangler dev --config cloudflare/dashboard/wrangler.toml --port 8788",
    "dash:deploy": "npx wrangler deploy --config cloudflare/dashboard/wrangler.toml",
    "db:schema": "npx wrangler d1 execute harvey-leads --remote --file cloudflare/schema.sql --config cloudflare/wrangler.toml",
    "pipeline": "node pipeline-agent.js",
    "billing": "node billing-agent.js",
    "setup": "node -e \"console.log(require('./core/datastore.js').ensure())\"",
    "scout": "node scout-agent.js",
    "dashboard": "node dashboard/server.js",
    "send-approval": "node send-approval.js",
    "monitor": "node monitor-agent.js",
    "followup": "node followup-agent.js",
    "termine": "node appointment-agent.js",
    "buchungen": "node bookings-agent.js",
    "watch": "node watch-agent.js",
    "report": "node watch-agent.js --report",
    "roi": "node watch-agent.js --quarter",
    "bank": "node bank-agent.js",
    "inbox": "node inbox-agent.js",
    "alert": "node alert-agent.js",
    "geo": "node geo-agent.js",
    "reviews": "node reviews-agent.js",
    "video": "node video-agent.js",
    "daily": "node daily.js",
    "schedule:install": "node autostart.js --install",
    "schedule:remove": "node autostart.js --remove",
    "onboarding": "node onboarding-agent.js",
    "buchhaltung": "node accounting-agent.js",
    "beitraege": "node content-agent.js",
    "marketing": "node marketing-agent.js",
    "anzeigenbilder": "node marketing-agent.js --creatives"
  },
  "devDependencies": {
    "wrangler": "^4.157.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "imapflow": "^1.7.8",
    "mailparser": "^3.14.2",
    "nodemailer": "^6.10.1",
    "playwright-core": "^1.64.1"
  }
}
